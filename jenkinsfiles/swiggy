
pipeline {
    agent any

    tools {
        jdk 'jdk'
        nodejs 'nodejs'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        SONARQUBE_SERVER = 'sonar-server'

        AWS_ACCOUNT_ID = '975324005004'
        AWS_ECR_REPO_NAME = 'swiggy'
        AWS_DEFAULT_REGION = 'us-east-1'
        REPOSITORY_URI = '975324005004.dkr.ecr.us-east-1.amazonaws.com'

        SONAR_TOKEN_CRED = 'sonarqube-token'

        GIT_REPO_NAME = 'Swiggy_Devops_end_to_end'
        GIT_USER_NAME = 'gmalo1998'
        GIT_EMAIL = 'malo.ganesh98@gmail.com'

        YAML_FILE = 'deployment.yml'
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/gmalo1998/Swiggy_Devops_end_to_end.git'
            }
        }

        stage('List Files') {
            steps {
                sh 'ls -la'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Swiggy') {
                    withSonarQubeEnv(env.SONARQUBE_SERVER) {
                        sh '''
                            ${SCANNER_HOME}/bin/sonar-scanner \
                            -Dsonar.projectName=swiggy \
                            -Dsonar.projectKey=swiggy
                        '''
                    }
                }
            }
        }

        stage('Quality Check') {
            steps {
                script {
                    waitForQualityGate(
                        abortPipeline: true,
                        credentialsId: env.SONAR_TOKEN_CRED
                    )
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Swiggy') {
                    sh '''
                        if [ -f package.json ]; then
                            npm ci
                        else
                            echo "Error: package.json not found!"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('Swiggy') {
                    sh '''
                        /usr/local/bin/trivy --config "" fs . \
                        > "${WORKSPACE}/trivyfs.txt"
                    '''
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('Swiggy') {
                    sh '''
                        docker build \
                        -t ${AWS_ECR_REPO_NAME}:latest .
                    '''
                }
            }
        }

        stage('ECR Image Pushing') {
            steps {
                sh '''
                    aws ecr get-login-password \
                    --region ${AWS_DEFAULT_REGION} | \
                    docker login \
                    --username AWS \
                    --password-stdin ${REPOSITORY_URI}

                    docker tag \
                    ${AWS_ECR_REPO_NAME}:latest \
                    ${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}

                    docker push \
                    ${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    /usr/local/bin/trivy --config "" image \
                    "${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}" \
                    > "${WORKSPACE}/trivyimage.txt"
                '''
            }
        }

        stage('Update Deployment File') {
            steps {
                dir('kubernetes-files') {

                    withCredentials([
    string(
        credentialsId: 'my-git-pattoken',
        variable: 'git_token'
    )
]) {

                        sh '''
                            git config user.email "${GIT_EMAIL}"
                            git config user.name "${GIT_USER_NAME}"

                            echo "Updating image to build: ${BUILD_NUMBER}"

                            if [ ! -f "${YAML_FILE}" ]; then
                                echo "Error: ${YAML_FILE} not found!"
                                exit 1
                            fi

                            sed -i \
                            "s#image:.*#image: ${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}#g" \
                            "${YAML_FILE}"

                            git add "${YAML_FILE}"

                            if ! git diff --cached --quiet; then

                                git commit -m "Update ${AWS_ECR_REPO_NAME} image to version ${BUILD_NUMBER}"

                                git push \
                                https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                                HEAD:main

                            else
                                echo "No deployment changes to commit"
                            fi
                        '''
                    }
                }
            }
        }
    }

    post {

        always {

            script {

                sh '''
                    if [ ! -f "${WORKSPACE}/trivyfs.txt" ]; then
                        echo "No Trivy filesystem report found" > "${WORKSPACE}/trivyfs.txt"
                    fi

                    if [ ! -f "${WORKSPACE}/trivyimage.txt" ]; then
                        echo "No Trivy image report found" > "${WORKSPACE}/trivyimage.txt"
                    fi
                '''

            }

            emailext(
                from: 'malo.ganesh98@gmail.com',
                replyTo: 'malo.ganesh98@gmail.com',
                attachLog: true,

                subject: "Build ${currentBuild.currentResult}: ${env.JOB_NAME}",

                body: """
                    <html>
                    <body>

                        <h2>Jenkins Pipeline Notification</h2>

                        <p><b>Project:</b> ${env.JOB_NAME}</p>

                        <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>

                        <p><b>Build Status:</b> ${currentBuild.currentResult}</p>

                        <p><b>Build URL:</b>
                        <a href="${env.BUILD_URL}">${env.BUILD_URL}</a>
                        </p>

                    </body>
                    </html>
                """,

                to: 'malo.ganesh98@gmail.com',
                mimeType: 'text/html',

                attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
            )
        }
    }
}
